# بيئة التشغيل
NODE_ENV=development
PORT=3000
HOST=0.0.0.0
APP_NAME=Qatfa_API
API_PREFIX=api/v1

# قاعدة البيانات (PostgreSQL 16)
DB_HOST=localhost
DB_PORT=5432
DB_USER=qatfa_user
DB_PASSWORD=qatfa_secure_pass_2026
DB_NAME=qatfa_db
DB_SCHEMA=public
DB_SYNC=true
DB_LOGGING=false

# الذاكرة المؤقتة (Redis 7)
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=qatfa_redis_pass_2026

# الأمان والمصادقة (JWT)
JWT_SECRET=qatfa_super_jwt_secret_key_production_grade_967_yemen
JWT_EXPIRATION=30d

# التخزين السحابي (Cloudflare R2)
R2_ACCOUNT_ID=mock_cf_account_id
R2_ACCESS_KEY_ID=mock_r2_access_key
R2_SECRET_ACCESS_KEY=mock_r2_secret_key
R2_BUCKET_NAME=qatfa-media
R2_PUBLIC_URL=https://cdn.qatfa.ye

# إعدادات الإصدارات والتحديث الهجين (App Version Control Engine)
CURRENT_LATEST_VERSION=1.0.0
CURRENT_LATEST_BUILD=1
MIN_SUPPORTED_VERSION=1.0.0
MIN_SUPPORTED_BUILD=1
TELEGRAM_CHANNEL_URL=https://t.me/qatfa_app
APK_DOWNLOAD_URL=https://cdn.qatfa.ye/releases/qatfa-v1.0.0.apk
