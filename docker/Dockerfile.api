# مرحلة البناء (Build Stage)
FROM node:22-alpine AS builder

WORKDIR /app

# تثبيت مدير الحزم pnpm
RUN corepack enable && corepack prepare pnpm@12.6.0 --activate

# نسخ ملفات التكوين لبيئة Monorepo
COPY package.json pnpm-workspace.yaml* pnpm-lock.yaml* ./
COPY packages/shared-types ./packages/shared-types
COPY apps/api ./apps/api

# تثبيت التبعيات وبناء الحزم
RUN pnpm install --frozen-lockfile=false
RUN pnpm --filter @qatfa/shared-types build
RUN pnpm --filter @qatfa/api build

# مرحلة التشغيل في الإنتاج (Production Runner Stage)
FROM node:22-alpine AS runner

WORKDIR /app

ENV NODE_ENV=production
RUN corepack enable && corepack prepare pnpm@12.6.0 --activate

COPY package.json pnpm-workspace.yaml* ./
COPY packages/shared-types/package.json ./packages/shared-types/
COPY packages/shared-types/dist ./packages/shared-types/dist
COPY apps/api/package.json ./apps/api/
COPY --from=builder /app/apps/api/dist ./apps/api/dist
COPY --from=builder /app/node_modules ./node_modules
COPY --from=builder /app/apps/api/node_modules ./apps/api/node_modules

EXPOSE 3000

CMD ["node", "apps/api/dist/main"]
